<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dialog SYSTEM "https://hendeca.moe/schema/v1/minidialog.dtd">
<dialog afterAction="none" pause="false">
    <title>Piano</title>
    <inputs>
        <input type="option" id="instrument">
            <label>Instrument</label>
            <!-- each option value corresponds to a block.note_block.XXX sound key -->
            <option value="banjo">
                <sprite:block/hay_block_side> <yellow>Banjo</yellow>
            </option>
            <option value="basedrum">
                <sprite:block/stone> <gray>Bass Drum</gray>
            </option>
            <option value="bass">
                <sprite:block/oak_planks> <gold>Bass</gold>
            </option>
            <option value="bell">
                <sprite:items:item/bell> <yellow>Bell</yellow>
            </option>
            <option value="bit">
                <sprite:block/emerald_block> <green>Bit</green>
            </option>
            <option value="chime">
                <sprite:block/packed_ice> <aqua>Chime</aqua>
            </option>
            <option value="cow_bell">
                <sprite:block/soul_sand> <dark_red>Cow Bell</dark_red>
            </option>
            <option value="didgeridoo">
                <sprite:block/pumpkin_side> <gold>Didgeridoo</gold>
            </option>
            <option value="flute">
                <sprite:block/clay> <grey>Flute</grey>
            </option>
            <option value="guitar">
                <sprite:block/white_wool> <white>Guitar</white>
            </option>
            <option value="harp">
                <sprite:block/dirt> <red>Harp</red>
            </option>
            <option value="hat">
                <sprite:block/glass> <white>Hi-hat</white>
            </option>
            <option value="iron_xylophone">
                <sprite:block/iron_block> <white>Iron Xylophone</white>
            </option>
            <option value="pling">
                <sprite:block/glowstone> <yellow>Pling</yellow>
            </option>
            <option value="snare">
                <sprite:block/sand> <yellow>Snare Drum</yellow>
            </option>
            <option value="trumpet">
                <sprite:block/copper_block> <red>Trumpet</red>
            </option>
            <option value="trumpet_exposed">
                <sprite:block/exposed_copper> <red>Exposed Trumpet</red>
            </option>
            <option value="trumpet_oxidized">
                <sprite:block/oxidized_copper> <dark_aqua>Oxidized Trumpet</dark_aqua>
            </option>
            <option value="trumpet_weathered">
                <sprite:block/weathered_copper> <dark_aqua>Weathered Trumpet</dark_aqua>
            </option>
            <option value="xylophone">
                <sprite:block/bone_block_side> <white>Xylophone</white>
            </option>
        </input>
    </inputs>
    <actions columns="5">
        <!-- see https://minecraft.wiki/w/Note_Block#Notes -->
        <action type="custom" id="play00" width="32">
            <label><#59E800><sprite:particles:note></label>
            <tooltip>F#5</tooltip>
        </action>
        <action type="custom" id="play01" width="32">
            <label><#82CE00><sprite:particles:note></label>
            <tooltip>G5</tooltip>
        </action>
        <action type="custom" id="play02" width="32">
            <label><#ACAC00><sprite:particles:note></label>
            <tooltip>G#5</tooltip>
        </action>
        <action type="custom" id="play03" width="32">
