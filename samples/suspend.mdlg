<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dialog SYSTEM "https://hendeca.moe/schema/v1/minidialog.dtd">
<dialog afterAction="waitForResponse" pause="false">
    <title>Suspend</title>
    <body>
        <message>
            <yellow><b>
                This is a test of the notice dialog with the waitForResponse action.
                After clicking Continue, you will need to wait a few seconds before
                closing the dialog. If you don't want to do this, press
                <red><lang:key.keyboard.escape></red> now.
            </b></yellow>
        </message>
        <message id="time"/>
    </body>
    <footer>
        <action type="custom">
            <label>Continue</label>
        </action>
    </footer>
</dialog>