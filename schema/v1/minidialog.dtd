<!-- MiniDialog schema v1 -->

<!-- <dialog> -->
    <!-- The root of a MiniDialog document or a sub-dialog embedded within a "showDialog" action. The dialog should either provide its own content or have a "src" property with a resource location to an external dialog. -->
    <!ELEMENT dialog (title|externalTitle|body|inputs|actions|footer)*>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST dialog id ID #IMPLIED>
    <!-- Serial version ID of the dialog. Reserved for future use in aiding major changes to the specification. -->
    <!ATTLIST dialog version (1) "1">
    <!-- A resource location to an external dialog. If set, the tag should be empty. -->
    <!ATTLIST dialog src CDATA #IMPLIED>
    <!-- True if the dialog can be dismissed with the Escape key. -->
    <!ATTLIST dialog canCloseWithEscape (true|false) "true">
    <!-- True if the dialog should pause the game in singleplayer mode. -->
    <!ATTLIST dialog pause (true|false) "true">
    <!-- An additional operation performed on the dialog after click or submit actions. -->
    <!ATTLIST dialog afterAction (close|none|waitForResponse) "close">

<!-- <title> -->
    <!-- Title for a dialog. Content is interpreted as MiniMessage. -->
    <!ELEMENT title (#PCDATA)>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST title id ID #IMPLIED>

<!-- <externalTitle> -->
    <!-- External title (title used by referent actions) for a dialog. Content is interpreted as MiniMessage. -->
    <!ELEMENT externalTitle (#PCDATA)>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST externalTitle id ID #IMPLIED>

<!-- <body> -->
    <!-- Main content of a dialog. May contain any number of message and item tags. -->
    <!ELEMENT body (message|item)*>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST body id ID #IMPLIED>

<!-- <message> -->
    <!-- Text within the body of a dialog. Content is interpreted as MiniMessage. -->
    <!ELEMENT message (#PCDATA)>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST message id ID #IMPLIED>
    <!-- The width of the message. Defaults to 200. -->
    <!ATTLIST message width CDATA "200">

<!-- <item> -->
    <!-- An item within the body of a dialog. Use the "src" attribute to set the item type. Content is NOT interpreted as MiniMessage, use the description tag to add a description. -->
    <!ELEMENT item (description)*>
    <!-- A unique identifier for runtime usage. Do not confuse with "src". -->
    <!ATTLIST item id ID #IMPLIED>
    <!-- The item type as a resource location. -->
    <!ATTLIST item src CDATA #IMPLIED>
    <!-- The stack size of the item. -->
    <!ATTLIST item count CDATA "1">
    <!-- The width of the item. Defaults to 16. -->
    <!ATTLIST item width CDATA "16">
    <!-- The height of the item. Defaults to 16. -->
    <!ATTLIST item height CDATA "16">
    <!-- If true (default), shows count and damage bar. -->
    <!ATTLIST item showDecoration (true|false) "true">
    <!-- If true (default), shows tooltip when hovered. -->
    <!ATTLIST item showTooltip (true|false) "true">

<!-- <description> -->
    <!-- Description text, interpreted as MiniMessage. Currently only used for item elements. -->
    <!ELEMENT description (#PCDATA)>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST description id ID #IMPLIED>
    <!-- The width of the description text. Defaults to 200. -->
    <!ATTLIST description width CDATA "200">

<!-- <inputs> -->
    <!-- A list of inputs for a dialog. May contain arbitrarily many input elements. -->
    <!ELEMENT inputs (input)*>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST inputs id ID #IMPLIED>

<!-- <input> -->
    <!-- An input for a dialog, placed within the inputs element. -->
    <!ELEMENT input (label|multiline|option)*>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST input id ID #IMPLIED>
    <!-- The type of the dialog; one of text, boolean, option or range. The maxLength property may only be used with "text" and the start, end and step properties may only be used with "range". -->
    <!ATTLIST input type (text|boolean|option|range) #REQUIRED>
    <!-- Width of the input. Defaults to 200. -->
    <!ATTLIST input width CDATA "200">
    <!-- Initial value of the input. For "text" inputs, may be any string. For "boolean" inputs, may be "true" or "false". For "option" inputs, may be the value property of any option it contains. For "range" inputs, may be any number it encloses. -->
    <!ATTLIST input initial CDATA #IMPLIED>
    <!-- Maximum length of the text value of the input. Only applicable for "text" inputs. -->
    <!ATTLIST input maxLength CDATA "32">
    <!-- Start of the number range. Only applicable for "range" inputs. It is heavily suggested to explicitly define this as there is no vanilla default. -->
    <!ATTLIST input start CDATA #IMPLIED>
    <!-- End of the number range. Only applicable for "range" inputs. It is heavily suggested to explicitly define this as there is no vanilla default. -->
    <!ATTLIST input end CDATA #IMPLIED>
    <!-- Interval of legal values between start and end. Only applicable for "range" inputs. -->
    <!ATTLIST input step CDATA #IMPLIED>

<!-- <label> -->
    <!-- A label for an input or action element. Content is interpreted as MiniMessage. -->
    <!ELEMENT label (#PCDATA)>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST label id ID #IMPLIED>
    <!-- True if the label is visible. Only respected for text inputs and option inputs. Defaults to true. -->
    <!ATTLIST label visible (true|false) "true">
    <!-- Format of the label. Only applicable for "range" inputs. The format should be a translatable key which will receive the label (%1s) and the current value (%2s) as arguments. Defaults to "options.generic_value". -->
    <!ATTLIST label format CDATA "options.generic_value">

<!-- <multiline> -->
    <!-- Enables multiline mode when added to a "text" input. The maxLines and height properties may also be specified. -->
    <!ELEMENT multiline EMPTY>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST multiline id ID #IMPLIED>
    <!-- The maximum number of lines in the input value. -->
    <!ATTLIST multiline maxLines CDATA #IMPLIED>
    <!-- The height of the input. -->
    <!ATTLIST multiline height CDATA #IMPLIED>

<!-- <option> -->
    <!-- An option specification within an "option" input. Content is the display text, interpreted as MiniMessage. -->
    <!ELEMENT option (#PCDATA)>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST option id ID #IMPLIED>
    <!-- The programmatic value of this option, filling the input value when selected. -->
    <!ATTLIST option value CDATA #REQUIRED>

<!-- <actions> -->
    <!-- A list of actions in a dialog. When populated with 1 or more action elements, the dialog resolves to "multi_action" type and therefore prohibits more than 1 action in the footer. -->
    <!ELEMENT actions (action)*>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST actions id ID #IMPLIED>
    <!-- The number of columns to align actions within. Defaults to 2. -->
    <!ATTLIST actions columns CDATA "2">

<!-- <action> -->
    <!-- A clickable action within the actions or footer element of a dialog. Should contain a label, may contain a tooltip, and should contain a dialog when type is "showDialog". -->
    <!ELEMENT action (label|tooltip|dialog)*>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST action id ID #IMPLIED>
    <!-- The type of this action. Must be one of openUrl, runCommand, suggestCommand, copyToClipboard, showDialog or custom. -->
    <!ATTLIST action type (openUrl|runCommand|suggestCommand|copyToClipboard|showDialog|custom) #REQUIRED>
    <!-- The width of this action. Defaults to 150. -->
    <!ATTLIST action width CDATA "150">
    <!-- The value of this action, interpreted based on its type. For "openUrl" actions, the URL to open. For "runCommand"/"suggestCommand" actions, the command to run with or without a leading slash. For "copyToClipboard" actions, the text to copy. For "showDialog"/"custom" actions, has no meaning. -->
    <!ATTLIST action value CDATA #IMPLIED>

<!-- <tooltip> -->
    <!-- A tooltip, currently only used for action elements. Content is interpreted as MiniMessage. -->
    <!ELEMENT tooltip (#PCDATA)>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST tooltip id ID #IMPLIED>

<!-- <footer> -->
    <!-- A special pseudo-block which may contain up to 2 actions. This resolves to the "exit action" at the bottom of the dialog OR the yes/no action of a confirmation dialog when not logically prohibited by the presence of 1 or more actions in the actions element. -->
    <!ELEMENT footer (action?,action?)>
    <!-- A unique identifier for runtime usage. -->
    <!ATTLIST footer id ID #IMPLIED>
