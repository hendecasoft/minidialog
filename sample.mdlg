<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dialog SYSTEM "schema/v1/minidialog.dtd">
<dialog version="1" canCloseWithEscape="true" pause="true" afterAction="close">
    <title>Title</title> <!-- required -->
    <externalTitle>foobar</externalTitle>
    <body>
        <message width="200">foobar</message>
        <item src="minecraft:diamond" count="1" width="16" height="16" showDecoration="true" showTooltip="true">
            <description width="200">foobar</description>
        </item>
    </body>
    <inputs>
        <input type="text" width="200" initial="foobar" maxLength="32">
            <label visible="true">foobar</label>
        </input>
        <input type="text" width="200" initial="foobar" maxLength="32">
            <label visible="true">foobar</label>
            <multiline maxLines="32" height="512"/>
        </input>
        <input type="boolean" initial="false">
            <label>foobar</label>
        </input>
        <input type="option" width="200" initial="z">
            <label visible="true">foobar</label>
            <option value="z">baz</option>
            <option value="q">baz</option>
        </input>
        <input type="range" width="200" start="0" end="100" step="1" initial="0">
            <label format="options.generic_value">foobar</label>
        </input>
    </inputs>
    <actions columns="2">
        <action type="openUrl" value="url" width="150">
            <label>foobar</label>
            <tooltip>foobar</tooltip>
        </action>
        <action type="runCommand" value="say hi" width="150">
            <label>foobar</label>
            <tooltip>foobar</tooltip>
        </action>
        <action type="suggestCommand" value="say hi" width="150">
            <label>foobar</label>
            <tooltip>foobar</tooltip>
        </action>
        <action type="copyToClipboard" value="text" width="150">
            <label>foobar</label>
            <tooltip>foobar</tooltip>
        </action>
        <action type="showDialog" width="150">
            <label>foobar</label>
            <tooltip>foobar</tooltip>
            <dialog src="minecraft:quick_actions"/>
        </action>
        <action type="custom" id="foobar"/>
    </actions>
    <footer>
        <!-- special space for up to 2 actions. placing 2 actions here forces the dialog type to be "confirmation" -->
        <action type="custom" id="foblar"/>
    </footer>
</dialog>
